# Copy this file to .env.local for local development.
# .env.local is gitignored.

# Supabase Postgres — three roles for defense-in-depth (RLS).
# See prisma/MIGRATIONS.md for the bootstrap SQL that creates the roles.
#
# - DATABASE_URL: app_user (NO BYPASSRLS). Used by every game-data query
#   wrapped in withRls() from @/lib/withRls. The transaction-scoped GUC
#   `app.current_user_id` is what the RLS policies key off.
# - BETTER_AUTH_DATABASE_URL: auth_service (BYPASSRLS). Used ONLY by
#   BetterAuth (signup, signin, session/account upsert). Application
#   code must never import dbAuth.
# - DIRECT_URL: postgres superuser. ONLY for prisma migrate — the
#   Prisma schema engine doesn't work through pgbouncer (port 6543).
#
# Both pooled URLs must use port 6543 + pgbouncer=true; DIRECT_URL uses 5432.
DATABASE_URL="postgresql://app_user.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
BETTER_AUTH_DATABASE_URL="postgresql://auth_service.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# BetterAuth — REQUIRED in production (boot will fail-fast if missing).
# - BETTER_AUTH_SECRET: 32+ random bytes, used to sign session cookies.
#   Generate with: openssl rand -base64 32
# - BETTER_AUTH_URL: the canonical origin the app is served on (must match
#   the host that issues cookies). On Vercel set to https://rkn-tycoon.ru.
BETTER_AUTH_SECRET="<32-byte-random-secret>"
BETTER_AUTH_URL="http://localhost:3000"
